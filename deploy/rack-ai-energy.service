[Unit]
Description=RackAI passive energy history collector
After=multi-user.target

[Service]
Type=notify
NotifyAccess=main
User=root
Group=tomp
ExecStart=/usr/bin/python3 -I /opt/rack-ai-energy/current/collector.py /etc/rack-ai-energy.json
WorkingDirectory=/opt/rack-ai-energy/current
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=10
WatchdogSec=120
TimeoutStartSec=30
TimeoutStopSec=10
StateDirectory=rack-ai-energy
StateDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
ReadWritePaths=/var/lib/rack-ai-energy
MemoryMax=128M
CPUQuota=5%
TasksMax=16
LogRateLimitIntervalSec=60
LogRateLimitBurst=5

[Install]
WantedBy=multi-user.target
