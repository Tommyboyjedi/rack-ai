[Unit]
Description=Hermes RackAI Interactive Inference Proxy
After=gpurack-rackai-tunnel.service
Requires=gpurack-rackai-tunnel.service

[Service]
Type=simple
EnvironmentFile=%h/.local/share/rackai-interactive-queue/current/interactive.env
ExecStart=/usr/bin/python3 %h/.local/share/rackai-interactive-queue/current/interactive-queue/proxy.py --listen 127.0.0.1:18103
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
