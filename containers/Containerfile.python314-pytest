FROM docker.io/library/python:3.14-slim

ENV CARGO_HOME=/opt/rack-rust/cargo \
    RUSTUP_HOME=/opt/rack-rust/rustup \
    PATH=/opt/rack-rust/cargo/bin:${PATH}

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl build-essential \
    && python3 -m pip install --no-cache-dir pytest==8.4.2 \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable \
    && python3 --version \
    && python3 -m pytest --version \
    && cargo --version \
    && rustc --version \
    && rm -rf /var/lib/apt/lists/*

# Rack AI executes acceptance with network disabled. This image deliberately
# contains the Python 3.14 pytest runtime and a current Rust toolchain.
