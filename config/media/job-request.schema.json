{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "rack-ai/media/v1"
    },
    "work_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "submission_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "profile_version": {
      "const": 1
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "negative_prompt": {
          "type": "string",
          "maxLength": 4096
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "width": {
          "type": "integer",
          "minimum": 64,
          "maximum": 1024,
          "multipleOf": 64
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "maximum": 1024,
          "multipleOf": 64
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [
        "prompt",
        "negative_prompt",
        "seed",
        "width",
        "height",
        "steps"
      ]
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 900
    },
    "priority": {
      "enum": [
        "low",
        "medium",
        "high",
        "paramount"
      ]
    },
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "generation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "generation": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        }
      }
    }
  },
  "required": [
    "schema",
    "work_id",
    "submission_id",
    "idempotency_key",
    "profile",
    "profile_version",
    "parameters",
    "timeout_seconds",
    "priority"
  ]
}
