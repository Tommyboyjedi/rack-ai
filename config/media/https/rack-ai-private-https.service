[Unit]
Description=Rack AI Tailscale-only HTTPS launcher
After=network-online.target tailscaled.service rack-ai-duckdns.service
Wants=network-online.target rack-ai-duckdns.service
[Service]
Type=simple
User=tomp
Group=tomp
WorkingDirectory=/srv/rack-ai-media/https
ExecStartPre=/usr/bin/python3 /srv/rack-ai-media/https/ops/proxy_prepare.py
ExecStartPre=/usr/sbin/nginx -t -p /srv/rack-ai-media/https/ -c /srv/rack-ai-media/https/config/nginx.conf
ExecStart=/usr/sbin/nginx -p /srv/rack-ai-media/https/ -c /srv/rack-ai-media/https/config/nginx.conf -g "daemon off;"
ExecReload=/usr/sbin/nginx -s reload -p /srv/rack-ai-media/https/ -c /srv/rack-ai-media/https/config/nginx.conf
Restart=on-failure
RestartSec=15
TimeoutStartSec=45
TimeoutStopSec=30
KillSignal=SIGQUIT
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/rack-ai-media/https
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
IPAddressDeny=any
IPAddressAllow=localhost
IPAddressAllow=100.64.0.0/10
MemoryMax=128M
TasksMax=16
[Install]
WantedBy=multi-user.target
