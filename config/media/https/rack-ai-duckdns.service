[Unit]
Description=Maintain Rack AI DuckDNS Tailscale address
After=network-online.target tailscaled.service
Wants=network-online.target
[Service]
Type=oneshot
User=tomp
Group=tomp
ExecStart=/usr/bin/python3 /srv/rack-ai-media/https/ops/update_dns.py
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/rack-ai-media/https
MemoryMax=96M
TasksMax=16
