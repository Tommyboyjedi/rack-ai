[Unit]
Description=Rack AI PR24 isolated ComfyUI (receiver owns activation)
[Service]
Type=simple
WorkingDirectory=/srv/rack-ai-media-runtime/ComfyUI
ExecStart=/srv/rack-ai-media-runtime/comfy-venv/bin/python /srv/rack-ai-media-runtime/ComfyUI/main.py --listen 127.0.0.1 --port 8190 --disable-auto-launch --disable-api-nodes --extra-model-paths-config /srv/rack-ai-media-candidate/extra-model-paths.yaml --output-directory /srv/rack-ai-media-candidate/output --input-directory /srv/rack-ai-media-candidate/input --temp-directory /srv/rack-ai-media-candidate/temp --user-directory /srv/rack-ai-media-candidate/user
Environment=CUDA_VISIBLE_DEVICES=REPLACE_WITH_VERIFIED_FULL_4080_SUPER_UUID
Environment=RACK_MEDIA_AUTHORITY_FILE=/srv/rack-ai-media-candidate/authority.json
Environment=RACK_MEDIA_CONTROL_SECRET_FILE=/srv/rack-ai-media-candidate/secrets/control
Environment=HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 PYTHONDONTWRITEBYTECODE=1
Environment=HF_HOME=/srv/rack-ai-media-candidate/hf-cache
Environment=PATH=/usr/bin:/bin
Restart=no
TimeoutStopSec=60
MemoryMax=28G
MemorySwapMax=0
CPUQuota=400%
Nice=10
UMask=0077
NoNewPrivileges=yes
KillMode=control-group
TasksMax=256
LimitNOFILE=4096
