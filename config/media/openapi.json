      "get": {
        "summary": "Download one verified artifact of a caller-owned completed job",
        "responses": {
          "200": {
            "description": "Exact PNG bytes; maximum 16 MiB",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
