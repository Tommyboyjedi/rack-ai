{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rack-ai/runtime/v1/response",
  "$defs": {
    "acquire": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "rack-ai/runtime/v1"
        },
        "source_system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "work_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "acquisition_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "priority": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high",
                "paramount"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "reasoning",
              "coding",
              "visual",
              "audio"
            ]
          },
          "uniqueItems": true
        },
        "context_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "qualification": {
          "type": "boolean"
        }
      },
      "required": [
        "schema",
        "source_system",
        "work_id",
        "acquisition_id",
        "tag",
        "capabilities",
        "context_tokens",
        "ttl_seconds",
        "qualification"
      ]
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "rack-ai/runtime/v1"
        },
        "submission_id": {
          "type": "string"
        },
        "reservation_id": {
          "type": "string"
        },
        "generation": {
          "type": "string"
        },
        "profile_hash": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "payload": {
          "$ref": "#/$defs/payload"
        },
        "wait_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 86400
        },
        "workspace_scope": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$",
          "description": "RackAI registered workspace execution scope; closed or missing scopes cannot admit new work."
        },
        "work": {
          "$ref": "#/$defs/work"
        }
      },
      "required": [
        "schema",
        "submission_id",
        "reservation_id",
        "generation",
        "profile_hash",
        "prompt",
        "max_tokens",
        "timeout_seconds"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "enum": [
            "chat_completions",
            "responses"
          ]
        },
        "body": {
          "type": "object"
        }
      },
      "required": [
        "protocol",
        "body"
      ]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generation": {
          "type": "string"
        },
        "action": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "renew"
                },
                "ttl_seconds": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "kind",
                "ttl_seconds"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "release"
                }
              },
              "required": [
                "kind"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "cancel"
                }
              },
              "required": [
                "kind"
              ]
            }
          ]
        }
      },
      "required": [
        "generation",
        "action"
      ]
    },
    "reserve": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "acquisition_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "work_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "services": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.-]+$"
          }
        },
        "priority": {
          "enum": [
            "low",
            "medium",
            "high",
            "paramount"
          ]
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "acquisition_id",
        "work_id",
        "services",
        "priority",
        "ttl_seconds"
      ]
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reservation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "work_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "wait_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 86400
        },
        "payload": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "inference"
                },
                "prompt": {
                  "type": "string"
                },
                "max_tokens": {
                  "type": "integer",
                  "minimum": 1
                },
                "timeout_seconds": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "kind",
                "prompt",
                "max_tokens",
                "timeout_seconds"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "workspace"
                },
                "workspace": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "repository": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[A-Za-z0-9_.-]+$"
                        },
                        "base_ref": {
                          "type": "string"
                        },
                        "base_sha": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "root": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "registered_root": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "base_ref"
                      ]
                    },
                    "objective": {
                      "type": "string",
                      "minLength": 1
                    },
                    "allowed_paths": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "acceptance": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "commands": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required_artifacts": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "commands"
                      ]
                    },
                    "requirements": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "complexity": {
                          "enum": [
                            "small",
                            "medium",
                            "large"
                          ]
                        },
                        "requires_large_context": {
                          "type": "boolean"
                        }
                      },
                      "required": []
                    },
                    "environment_resources": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "limits": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "max_implementation_attempts": {
                          "const": 1
                        },
                        "timeout_seconds": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 3600
                        },
                        "network": {
                          "enum": [
                            "disabled"
                          ]
                        }
                      },
                      "required": [
                        "max_implementation_attempts",
                        "timeout_seconds"
                      ]
                    }
                  },
                  "required": [
                    "repository",
                    "objective",
                    "allowed_paths",
                    "acceptance",
                    "limits"
                  ]
                }
              },
              "required": [
                "kind",
                "workspace"
              ]
            }
          ]
        }
      },
      "required": [
        "reservation_id",
        "service",
        "work_id",
        "payload"
      ]
    },
    "demand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/acquire"
        },
        "priority": {
          "enum": [
            "low",
            "medium",
            "high",
            "paramount"
          ]
        },
        "profile_hash": {
          "type": "string"
        },
        "state": {
          "enum": [
            "unavailable",
            "preparing",
            "ready",
            "preempting",
            "preempted",
            "releasing",
            "released",
            "cancelled",
            "expired",
            "recovery_required",
            "unavailable"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "generation": {
          "type": "string"
        },
        "created": {
          "type": "integer",
          "minimum": 0
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "deadline": {
          "type": "integer",
          "minimum": 0
        },
        "transition_deadline": {
          "type": "integer",
          "minimum": 0
        },
        "victims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "process": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "pid": {
                  "type": "integer",
                  "minimum": 0
                },
                "boot": {
                  "type": "string"
                },
                "start": {
                  "type": "string"
                },
                "activation": {
                  "type": "string"
                },
                "unit": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "container": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "invocation": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "pid",
                "boot",
                "start",
                "activation",
                "unit",
                "container",
                "invocation"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "effect_started": {
          "type": "boolean"
        },
        "preflight_done": {
          "type": "boolean"
        },
        "released": {
          "type": "boolean"
        },
        "gateway_path": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "profile_version": {
          "type": "string"
        },
        "context_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_input_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "image_input": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_images_per_request": {"type": "integer", "minimum": 1},
            "max_image_bytes": {"type": "integer", "minimum": 1},
            "max_image_pixels": {"type": "integer", "minimum": 1},
            "accepted_mime_types": {"type": "array", "items": {"type": "string"}},
            "accepted_url_schemes": {"type": "array", "items": {"type": "string"}}
          },
          "required": ["max_images_per_request", "max_image_bytes", "max_image_pixels", "accepted_mime_types", "accepted_url_schemes"]
        },
        "last_activity_at": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "access": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "native_comfyui"
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "session_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reservation_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.-]+$"
                },
                "generation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.-]+$"
                }
              },
              "required": [
                "kind",
                "url",
                "session_id",
                "reservation_id",
                "generation"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "managed_image"
                },
                "jobs_path": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "jobs_path"
              ]
            }
          ]
        },
        "reservation_id": {
          "type": "string"
        },
        "services": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "reserve_request": {
          "$ref": "#/$defs/reserve"
        },
        "retry_after": {
          "type": "integer",
          "minimum": 1
        },
        "preempted_by": {
          "type": "string"
        },
        "ready_checked": {
          "type": "boolean"
        },
        "accepted_calls": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "owner",
        "request",
        "priority",
        "profile_hash",
        "state",
        "reason",
        "generation",
        "created",
        "order",
        "deadline",
        "transition_deadline",
        "victims",
        "process",
        "effect_started",
        "preflight_done",
        "released",
        "profile_version",
        "context_tokens",
        "max_input_tokens",
        "max_output_tokens",
        "resources",
        "last_activity_at",
        "ready_checked",
        "accepted_calls"
      ],
      "anyOf": [
        {
          "required": [
            "gateway_path"
          ]
        },
        {
          "required": [
            "access"
          ]
        },
        {
          "properties": {
            "state": {
              "const": "unavailable"
            }
          },
          "required": [
            "state"
          ]
        }
      ]
    },
    "voiceListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voices"
      ],
      "properties": {
        "voices": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "voiceRegistrationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voice_id",
        "registered",
        "sha256"
      ],
      "properties": {
        "voice_id": {
          "type": "string"
        },
        "registered": {
          "const": true
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "speechResponse": {
      "type": "string",
      "format": "binary",
      "contentMediaType": "audio/wav",
      "description": "PCM16 mono 24000 Hz WAV; <=60 seconds and <=2880044 bytes."
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "rack-ai/runtime/v1"
    },
    "result": {
      "oneOf": [
        {
          "$ref": "#/$defs/demand"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "owner": {
              "type": "string"
            },
            "request": {
              "$ref": "#/$defs/inference"
            },
            "state": {
              "enum": [
                "queued",
                "running",
                "completed",
                "cancelled",
                "expired",
                "uncertain",
                "failed"
              ]
            },
            "started": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "activation": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "result": {},
            "error": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "waiting_deadline": {
              "type": "integer",
              "minimum": 0
            },
            "execution_deadline": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "response_bytes": {
              "type": "integer",
              "minimum": 1024
            },
            "cancellation": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "requested_at"
                  ],
                  "properties": {
                    "requested_at": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              ]
            },
            "late_result": {},
            "scope_access_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "queue_order": {
              "type": "integer",
              "minimum": 0
            },
            "result_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "late_result_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "id",
            "owner",
            "request",
            "state",
            "waiting_deadline",
            "started",
            "activation",
            "result",
            "error",
            "execution_deadline",
            "response_bytes",
            "cancellation",
            "late_result",
            "queue_order"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tags": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "tag": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  },
                  "qualified": {
                    "type": "boolean"
                  },
                  "capabilities": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "context_tokens": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "max_input_tokens": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "max_output_tokens": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "image_input": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "max_images_per_request": {"type": "integer", "minimum": 1},
                      "max_image_bytes": {"type": "integer", "minimum": 1},
                      "max_image_pixels": {"type": "integer", "minimum": 1},
                      "accepted_mime_types": {"type": "array", "items": {"type": "string"}},
                      "accepted_url_schemes": {"type": "array", "items": {"type": "string"}}
                    },
                    "required": ["max_images_per_request", "max_image_bytes", "max_image_pixels", "accepted_mime_types", "accepted_url_schemes"]
                  }
                },
                "required": [
                  "tag",
                  "version",
                  "qualified",
                  "capabilities",
                  "context_tokens",
                  "max_input_tokens",
                  "max_output_tokens"
                ]
              }
            },
            "default_priority": {
              "enum": [
                "low",
                "medium",
                "high",
                "paramount"
              ]
            },
            "priorities": {
              "type": "array",
              "items": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "paramount"
                ]
              }
            }
          },
          "required": [
            "tags",
            "priorities",
            "default_priority"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.-]+$"
            },
            "priority": {
              "enum": [
                "low",
                "medium",
                "high",
                "paramount"
              ]
            },
            "state": {
              "enum": [
                "unavailable",
                "preparing",
                "ready",
                "preempting",
                "preempted",
                "releasing",
                "released",
                "cancelled",
                "expired",
                "recovery_required",
                "unavailable",
                "partial"
              ]
