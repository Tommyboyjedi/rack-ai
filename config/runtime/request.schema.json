{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rack-ai/runtime/v1/request",
  "$defs": {
    "acquire": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "rack-ai/runtime/v1"
        },
        "source_system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "work_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "acquisition_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "priority": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high",
                "paramount"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "reasoning",
              "coding",
              "visual",
              "audio"
            ]
          },
          "uniqueItems": true
        },
        "context_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "qualification": {
          "type": "boolean"
        }
      },
      "required": [
        "schema",
        "source_system",
        "work_id",
        "acquisition_id",
        "tag",
        "capabilities",
        "context_tokens",
        "ttl_seconds",
        "qualification"
      ]
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "rack-ai/runtime/v1"
        },
        "submission_id": {
          "type": "string"
        },
        "reservation_id": {
          "type": "string"
        },
        "generation": {
          "type": "string"
        },
        "profile_hash": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "payload": {
          "$ref": "#/$defs/payload"
        },
        "wait_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 86400
        },
        "workspace_scope": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$",
          "description": "RackAI registered workspace execution scope; closed or missing scopes cannot admit new work."
        }
      },
      "required": [
        "schema",
        "submission_id",
        "reservation_id",
        "generation",
        "profile_hash",
        "prompt",
        "max_tokens",
        "timeout_seconds"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "enum": [
            "chat_completions",
            "responses"
          ]
        },
        "body": {
          "type": "object"
        }
      },
      "required": [
        "protocol",
        "body"
      ]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generation": {
          "type": "string"
        },
        "action": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "renew"
                },
                "ttl_seconds": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "kind",
                "ttl_seconds"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "release"
                }
              },
              "required": [
                "kind"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "cancel"
                }
              },
              "required": [
                "kind"
              ]
            }
          ]
        }
      },
      "required": [
        "generation",
        "action"
      ]
    },
    "reserve": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "acquisition_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "work_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "services": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.-]+$"
          }
        },
        "priority": {
          "enum": [
            "low",
            "medium",
            "high",
            "paramount"
          ]
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "acquisition_id",
        "work_id",
        "services",
        "priority",
        "ttl_seconds"
      ]
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reservation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "work_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "wait_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 86400
        },
        "payload": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "inference"
                },
                "prompt": {
                  "type": "string"
                },
                "max_tokens": {
                  "type": "integer",
                  "minimum": 1
                },
                "timeout_seconds": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "kind",
                "prompt",
                "max_tokens",
                "timeout_seconds"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "workspace"
                },
                "workspace": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "repository": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[A-Za-z0-9_.-]+$"
                        },
                        "base_ref": {
                          "type": "string"
                        },
                        "base_sha": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "root": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "registered_root": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "base_ref"
                      ]
                    },
                    "objective": {
                      "type": "string",
                      "minLength": 1
                    },
                    "allowed_paths": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "acceptance": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "commands": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required_artifacts": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "commands"
                      ]
                    },
                    "requirements": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "complexity": {
                          "enum": [
                            "small",
                            "medium",
                            "large"
                          ]
                        },
                        "requires_large_context": {
                          "type": "boolean"
                        }
                      },
                      "required": []
                    },
                    "environment_resources": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "limits": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "max_implementation_attempts": {
                          "const": 1
                        },
                        "timeout_seconds": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 3600
                        },
                        "network": {
                          "enum": [
                            "disabled"
                          ]
                        }
                      },
                      "required": [
                        "max_implementation_attempts",
                        "timeout_seconds"
                      ]
                    }
                  },
                  "required": [
                    "repository",
                    "objective",
                    "allowed_paths",
                    "acceptance",
                    "limits"
                  ]
                }
              },
              "required": [
                "kind",
                "workspace"
              ]
            }
          ]
        }
      },
      "required": [
        "reservation_id",
        "service",
        "work_id",
        "payload"
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "discover"
        }
      },
      "required": [
        "operation"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "acquire"
        },
        "request": {
          "$ref": "#/$defs/acquire"
        }
      },
      "required": [
        "operation",
        "request"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "inspect"
        },
        "reservation_id": {
          "type": "string"
        }
      },
      "required": [
        "operation",
        "reservation_id"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "control"
        },
        "reservation_id": {
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/control"
        }
      },
      "required": [
        "operation",
        "reservation_id",
        "request"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "infer"
        },
        "request": {
          "$ref": "#/$defs/inference"
        }
      },
      "required": [
        "operation",
        "request"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "result"
        },
        "invocation_id": {
          "type": "string"
        }
      },
      "required": [
        "operation",
        "invocation_id"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "reconcile"
        },
        "invocation_id": {
          "type": "string"
        }
      },
      "required": [
        "operation",
        "invocation_id"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "cancel"
        },
        "invocation_id": {
          "type": "string"
        }
      },
      "required": [
        "operation",
        "invocation_id"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "reserve"
        },
        "request": {
          "$ref": "#/$defs/reserve"
        }
      },
      "required": [
        "operation",
        "request"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "inspect_reservation"
        },
        "reservation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        }
      },
      "required": [
        "operation",
        "reservation_id"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "release_reservation"
        },
        "reservation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        }
      },
      "required": [
        "operation",
        "reservation_id"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "cancel_reservation"
        },
        "reservation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        }
      },
      "required": [
        "operation",
        "reservation_id"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "inspect_work"
        },
        "work_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        }
      },
      "required": [
        "operation",
        "work_id"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "cancel_work"
        },
        "work_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        }
      },
      "required": [
        "operation",
        "work_id"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "submit_work"
        },
        "request": {
          "$ref": "#/$defs/work"
        }
      },
      "required": [
        "operation",
        "request"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "refresh_reservation"
        },
        "reservation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        }
      },
      "required": [
        "operation",
        "reservation_id"
      ]
    }
  ]
}
