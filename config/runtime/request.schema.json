{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rack-ai/runtime/v1/request",
  "$defs": {
    "acquire": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "rack-ai/runtime/v1"
        },
        "source_system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "work_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "acquisition_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "priority": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high",
                "paramount"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "reasoning",
              "coding",
              "visual",
              "audio"
            ]
          },
          "uniqueItems": true
        },
        "context_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "qualification": {
          "type": "boolean"
        }
      },
      "required": [
        "schema",
        "source_system",
        "work_id",
        "acquisition_id",
        "tag",
        "capabilities",
        "context_tokens",
        "ttl_seconds",
        "qualification"
      ]
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "rack-ai/runtime/v1"
        },
        "submission_id": {
          "type": "string"
        },
        "reservation_id": {
          "type": "string"
        },
        "generation": {
          "type": "string"
        },
        "profile_hash": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "payload": {
          "$ref": "#/$defs/payload"
        },
        "wait_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 86400
        }
      },
      "required": [
        "schema",
        "submission_id",
        "reservation_id",
        "generation",
        "profile_hash",
        "prompt",
        "max_tokens",
        "timeout_seconds"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "enum": [
            "chat_completions",
            "responses"
          ]
        },
        "body": {
          "type": "object"
        }
      },
      "required": [
        "protocol",
        "body"
      ]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generation": {
          "type": "string"
        },
        "action": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "renew"
                },
                "ttl_seconds": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "kind",
                "ttl_seconds"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "release"
                }
              },
              "required": [
                "kind"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "cancel"
                }
              },
              "required": [
                "kind"
              ]
            }
          ]
        }
      },
      "required": [
        "generation",
        "action"
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "discover"
        }
      },
      "required": [
        "operation"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "acquire"
        },
        "request": {
          "$ref": "#/$defs/acquire"
        }
      },
      "required": [
        "operation",
        "request"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "inspect"
        },
        "reservation_id": {
          "type": "string"
        }
      },
      "required": [
        "operation",
        "reservation_id"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "control"
        },
        "reservation_id": {
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/control"
        }
      },
      "required": [
        "operation",
        "reservation_id",
        "request"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "infer"
        },
        "request": {
          "$ref": "#/$defs/inference"
        }
      },
      "required": [
        "operation",
        "request"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "result"
        },
        "invocation_id": {
          "type": "string"
        }
      },
      "required": [
        "operation",
        "invocation_id"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "reconcile"
        },
        "invocation_id": {
          "type": "string"
        }
      },
      "required": [
        "operation",
        "invocation_id"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "cancel"
        },
        "invocation_id": {
          "type": "string"
        }
      },
      "required": [
        "operation",
        "invocation_id"
      ]
    }
  ]
}
