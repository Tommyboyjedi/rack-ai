{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rack-ai/campaign.json",
  "title": "Rack AI Campaign Schema",
  "type": "object",
  "required": [
    "version",
    "campaign_id",
    "repository",
    "branch",
    "permitted_paths",
    "allow_local_commits",
    "limits",
    "worker_policy",
    "steps"
  ],
  "properties": {
    "version": { "type": "string", "const": "rack-ai/campaign/v1" },
    "campaign_id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
    "repository": {
      "type": "object",
      "required": ["id", "base_ref", "base_sha"],
      "properties": {
        "id": { "type": "string" },
        "base_ref": { "type": "string" },
        "base_sha": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" }
      }
    },
    "branch": { "type": "string" },
    "permitted_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "allow_local_commits": { "type": "boolean", "const": true },
    "limits": {
      "type": "object",
      "required": [
        "max_runtime_seconds",
        "max_steps",
        "max_total_attempts",
        "heartbeat_seconds",
        "network"
      ],
      "properties": {
        "max_runtime_seconds": { "type": "integer", "minimum": 60, "maximum": 172800 },
        "max_steps": { "type": "integer", "minimum": 1, "maximum": 16 },
        "max_total_attempts": { "type": "integer", "minimum": 1, "maximum": 32 },
        "heartbeat_seconds": { "type": "integer", "minimum": 10, "maximum": 60 },
        "network": { "type": "string", "const": "disabled" }
      }
    },
    "worker_policy": {
      "type": "object",
      "required": [
        "primary",
        "fallback",
        "primary_attempts",
        "repair_attempts",
        "fallback_attempts"
      ],
      "properties": {
        "primary": { "type": "string" },
        "fallback": { "type": "string" },
        "primary_attempts": { "type": "integer", "minimum": 1 },
        "repair_attempts": { "type": "integer", "minimum": 0 },
        "fallback_attempts": { "type": "integer", "minimum": 0 }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["id", "kind", "task", "allowed_paths", "acceptance", "limits"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
          "kind": { "type": "string", "enum": ["implementation", "verification"] },
          "task": { "type": "string", "minLength": 1 },
          "allowed_paths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "required_changed_paths": {
            "type": "array",
            "items": { "type": "string" }
          },
          "acceptance": {
            "type": "object",
            "required": ["commands"],
            "properties": {
              "commands": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" }
                }
              },
              "required_artifacts": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "limits": {
            "type": "object",
            "required": ["timeout_seconds", "network"],
            "properties": {
              "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 900 },
              "network": { "type": "string", "const": "disabled" }
            }
          }
        }
      }
    }
  }
}
