{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rack-ai/change-request.json",
  "title": "Rack AI Change Request",
  "type": "object",
  "required": ["change_id", "repository", "task", "allowed_paths", "acceptance", "limits"],
  "properties": {
    "change_id": {"type": "string", "minLength": 1},
    "repository": {
      "type": "object",
      "required": ["id", "base_ref"],
      "properties": {
        "id": {"type": "string"},
        "registered_root": {"type": "string"},
        "root": {"type": "string"},
        "base_ref": {"type": "string"},
        "base_sha": {"type": ["string", "null"]}
      }
    },
    "task": {"type": "string", "minLength": 1},
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "acceptance": {
      "type": "object",
      "required": ["commands"],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          }
        },
        "required_artifacts": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "limits": {
      "type": "object",
      "required": ["max_implementation_attempts", "timeout_seconds"],
      "properties": {
        "max_implementation_attempts": {"type": "integer", "minimum": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "network": {"type": "string", "const": "disabled"}
      }
    }
  }
}
