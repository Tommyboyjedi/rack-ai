{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rack-ai/task-dag.json",
  "title": "Rack AI Task DAG",
  "type": "object",
  "required": ["nodes"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "worker", "cwd", "prompt"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "worker": {"type": "string"},
          "cwd": {"type": "string"},
          "prompt": {"type": "string"},
          "images": {
            "type": "array",
            "items": {
              "anyOf": [
                {"type": "string", "minLength": 1},
                {
                  "type": "object",
                  "required": ["source"],
                  "properties": {"source": {"type": "string", "minLength": 1}}
                }
              ]
            }
          },
          "depends_on": {
            "type": "array",
            "items": {"type": "string"}
          },
          "artifacts": {"type": "array"}
        }
      }
    }
  }
}
