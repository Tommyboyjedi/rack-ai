{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rack-ai/task-dag.json",
  "title": "Rack AI Task DAG",
  "type": "object",
  "required": ["nodes"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "worker", "cwd", "prompt"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "worker": {"type": "string"},
          "cwd": {"type": "string"},
          "prompt": {"type": "string"},
          "depends_on": {
            "type": "array",
            "items": {"type": "string"}
          },
          "artifacts": {"type": "array"}
        }
      }
    }
  }
}
