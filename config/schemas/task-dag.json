{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rack-ai/task-dag.json",
  "title": "Rack AI Task DAG",
  "type": "object",
  "required": ["nodes"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string"},
          "depends_on": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
