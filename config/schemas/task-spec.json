{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rack-ai/task-spec.json",
  "title": "Rack AI Task Spec",
  "type": "object",
  "required": ["task_id"],
  "properties": {
    "task_id": {"type": "string"},
    "template": {"type": "string"},
    "request": {"type": ["string", "null"]},
    "placement": {
      "type": "object",
      "properties": {
        "worker_ids": {"type": "array", "items": {"type": "string"}},
        "resource_ids": {"type": "array", "items": {"type": "string"}},
        "model_ids": {"type": "array", "items": {"type": "string"}},
        "backends": {"type": "array", "items": {"type": "string"}}
      }
    },
    "dag": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "worker", "cwd", "prompt"],
            "properties": {
              "id": {"type": "string"},
              "name": {"type": "string"},
              "worker": {"type": "string"},
              "cwd": {"type": "string"},
              "prompt": {"type": "string"},
              "depends_on": {"type": "array", "items": {"type": "string"}},
              "artifacts": {"type": "array"}
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "worker", "cwd", "prompt"],
        "properties": {
          "name": {"type": "string"},
          "worker": {"type": "string"},
          "cwd": {"type": "string"},
          "prompt": {"type": "string"},
          "artifacts": {"type": "array"}
        }
      }
    },
    "max_attempts": {"type": "integer", "minimum": 1},
    "timeout_seconds": {"type": "integer", "minimum": 1}
  }
}
