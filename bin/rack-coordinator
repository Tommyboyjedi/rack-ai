#!/usr/bin/env python3
import argparse
import json
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
TEMPLATE_PATH = REPO_ROOT / "config" / "task_templates.json"


def load_templates() -> dict:
    with TEMPLATE_PATH.open("r", encoding="utf-8") as handle:
        return json.load(handle)


def utc_stamp() -> str:
    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def parse_artifact_exact(values: list[str]) -> list[dict]:
    artifacts = []
    for value in values:
        path, exact = value.split("=", 1)
        artifacts.append({"path": path, "exact_text": exact})
    return artifacts


def parse_artifact_contains(values: list[str]) -> list[dict]:
    artifacts = []
    for value in values:
        path, marker = value.split("=", 1)
        artifacts.append({"path": path, "must_contain": marker})
    return artifacts


def choose_template(request: str) -> str:
    text = request.lower()
    padded = f" {text} "

    def has_phrase(phrases: list[str]) -> bool:
        return any(f" {phrase} " in padded for phrase in phrases)

    if has_phrase(["verify tests", "run tests", "smoke test"]):
        return "test"
    if any(token in text.split() for token in ["test", "pytest", "unittest"]):
        return "test"
    if has_phrase(["design only", "do not implement"]):
        return "plan"
    if any(token in text.split() for token in ["plan", "brainstorm", "proposal"]):
        return "plan"
    if has_phrase(["check whether", "confirm whether", "validate whether"]):
        return "verify"
    if any(token in text.split() for token in ["verify", "validate", "confirm", "check"]):
        return "verify"
    if any(token in text.split() for token in ["implement", "create", "modify", "change", "patch", "update", "fix", "write"]):
        return "patch"
    return "patch"


def build_spec(template_name: str, request: str, cwd: str, exact_artifacts: list[dict], contains_artifacts: list[dict]) -> dict:
    templates = load_templates()
    try:
        template = templates[template_name]
    except KeyError as exc:
        raise ValueError(f"unknown template: {template_name}") from exc

    steps = []
    raw_steps = template["steps"]
    final_artifacts = exact_artifacts + contains_artifacts
    for index, raw in enumerate(raw_steps, start=1):
        step = {
            "name": raw["name"],
            "worker": raw["worker"],
            "cwd": cwd,
            "prompt": raw["prompt"].format(request=request),
            "artifacts": [],
        }
        if index == len(raw_steps):
            step["artifacts"] = final_artifacts
        steps.append(step)

    task_id = f"{utc_stamp()}-{template_name}"
    return {
        "task_id": task_id,
        "template": template_name,
        "request": request,
        "steps": steps,
    }


def main() -> int:
    parser = argparse.ArgumentParser(description="Rack coordinator scaffold")
    parser.add_argument("--template", choices=sorted(load_templates().keys()))
    parser.add_argument("--auto-template", action="store_true", help="Choose a template from the request text")
    parser.add_argument("--cwd", default="/tmp/jcode-rack-test")
    parser.add_argument("--request-file")
    parser.add_argument("--output")
    parser.add_argument("--artifact-exact", action="append", default=[])
    parser.add_argument("--artifact-contains", action="append", default=[])
    parser.add_argument("--preview", action="store_true", help="Print the generated spec JSON before exiting or running")
    parser.add_argument("--run", action="store_true")
    parser.add_argument("request", nargs="?")
    args = parser.parse_args()

    if args.request_file:
        request = Path(args.request_file).read_text(encoding="utf-8")
    elif args.request is not None:
        request = args.request
    else:
        request = sys.stdin.read()

    if not request.strip():
        print("Request is empty.", file=sys.stderr)
        return 2

    template_name = args.template
    if template_name is None:
        template_name = choose_template(request) if args.auto_template else "patch"

    spec = build_spec(
        template_name,
        request,
        args.cwd,
        parse_artifact_exact(args.artifact_exact),
        parse_artifact_contains(args.artifact_contains),
    )

    if args.output:
        spec_path = Path(args.output)
    else:
        spec_dir = REPO_ROOT / "logs" / "specs"
        spec_dir.mkdir(parents=True, exist_ok=True)
        spec_path = spec_dir / f"{spec['task_id']}.json"
    spec_path.parent.mkdir(parents=True, exist_ok=True)
    spec_path.write_text(json.dumps(spec, indent=2) + "\n", encoding="utf-8")

    if args.preview:
        sys.stdout.write(json.dumps(spec, indent=2) + "\n")
        if not args.run:
            return 0

    if not args.run:
        print(str(spec_path))
        return 0

    cp = subprocess.run([str(REPO_ROOT / "bin" / "rack-task"), "--emit-json", str(spec_path)], capture_output=True, text=True, check=False)
    sys.stdout.write(cp.stdout)
    if cp.stderr:
        sys.stderr.write(cp.stderr)
    return cp.returncode


if __name__ == "__main__":
    raise SystemExit(main())
