#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  rack-primary [--cwd DIR] [--gateway-url URL] [--idempotency-key KEY] [--image FILE_OR_DATA_URI] -- PROMPT
  rack-primary [--cwd DIR] [--gateway-url URL] [--idempotency-key KEY] [--image FILE_OR_DATA_URI] --prompt-file FILE
  rack-primary [--cwd DIR]

If no prompt argument is supplied, prompt text is read from stdin.
USAGE
}

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cwd="$(pwd)"
prompt_file=""
prompt=""
gateway_url="${RACK_AI_SCOPED_GATEWAY:-}"
idempotency_key=""
images=()

while (($#)); do
  case "$1" in
    --cwd)
      cwd="$2"
      shift 2
      ;;
    --prompt-file)
      prompt_file="$2"
      shift 2
      ;;
    --gateway-url)
      gateway_url="$2"
      shift 2
      ;;
    --idempotency-key)
      idempotency_key="$2"
      shift 2
      ;;
    --image)
      images+=("$2")
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      prompt="$*"
      break
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ -n "$prompt_file" ]]; then
  prompt="$(cat "$prompt_file")"
elif [[ -z "$prompt" ]]; then
  prompt="$(cat)"
fi

if [[ -z "${prompt//[[:space:]]/}" ]]; then
  echo "Prompt is empty." >&2
  exit 2
fi

if ((${#images[@]})); then
  if [[ -z "$gateway_url" ]]; then
    echo "Image calls require --gateway-url or RACK_AI_SCOPED_GATEWAY from a managed reservation." >&2
    exit 2
  fi
  args=(primary-worker --repo-root "$repo_root" --state-root "$repo_root" --cwd "$cwd" --gateway-url "$gateway_url")
  if [[ -n "$idempotency_key" ]]; then
    args+=(--idempotency-key "$idempotency_key")
  fi
  for image in "${images[@]}"; do
    args+=(--image "$image")
  done
  cd "$repo_root"
  exec cargo run -q -p rack_ai_cli -- "${args[@]}" -- "$prompt"
fi

exec /home/tomp/.local/bin/jcode --provider-profile local-primary --model local-primary -C "$cwd" run "$prompt"
