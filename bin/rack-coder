#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cwd="$(pwd)"
arguments=()
while (($#)); do
  case "$1" in
    --cwd)
      cwd="$2"
      arguments+=("$1" "$2")
      shift 2
      ;;
    *)
      arguments+=("$1")
      shift
      ;;
  esac
done
mkdir -p "$cwd"
exec "$repo_root/bin/rack-coder-jcode" "${arguments[@]}"
