#!/usr/bin/env python3
import argparse
import json
from pathlib import Path

from racklib import list_leases, load_json

REPO_ROOT = Path(__file__).resolve().parent.parent
QUEUED_DIR = REPO_ROOT / "state" / "queue" / "queued"
RUNNING_DIR = REPO_ROOT / "state" / "queue" / "running"
RUNS_DIR = REPO_ROOT / "state" / "runs"


def main() -> int:
    parser = argparse.ArgumentParser(description="Show Rack AI queue and run status")
    parser.add_argument("--emit-json", action="store_true")
    args = parser.parse_args()

    queued = sorted(p.name for p in QUEUED_DIR.glob("*.json")) if QUEUED_DIR.exists() else []
    running = sorted(p.name for p in RUNNING_DIR.glob("*.json")) if RUNNING_DIR.exists() else []
    runs = []
    if RUNS_DIR.exists():
        for path in sorted(RUNS_DIR.glob("*.json")):
            payload = load_json(path)
            runs.append(
                {
                    "task_id": payload.get("task_id"),
                    "status": payload.get("status"),
                    "attempt": payload.get("attempt"),
                    "max_attempts": payload.get("max_attempts"),
                    "last_error": payload.get("last_error"),
                    "admission_state": payload.get("admission_state"),
                    "waiting_on_resources": payload.get("waiting_on_resources", []),
                    "placement": payload.get("placement"),
                    "active_node_id": payload.get("active_node_id"),
                    "dag_state": payload.get("dag_state"),
                }
            )

    summary = {"queued": queued, "running": running, "leases": list_leases(), "runs": runs}
    if args.emit_json:
        print(json.dumps(summary, indent=2))
        return 0

    print(f"Queued: {len(queued)}")
    for item in queued:
        print(f"  - {item}")
    print(f"Running: {len(running)}")
    for item in running:
        print(f"  - {item}")
    print(f"Leases: {len(summary['leases'])}")
    for lease in summary["leases"]:
        print(f"  - {lease['resource_id']}: {lease.get('task_id')}")
    print(f"Runs: {len(runs)}")
    for item in runs:
        waiting = item["waiting_on_resources"] or []
        waiting_text = f" waiting={','.join(waiting)}" if waiting else ""
        active_node = f" node={item['active_node_id']}" if item.get("active_node_id") else ""
        print(
            f"  - {item['task_id']}: {item['status']} "
            f"(attempt {item['attempt']}/{item['max_attempts']}, admission={item['admission_state']})"
            f"{active_node}{waiting_text}"
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
