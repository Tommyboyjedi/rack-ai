#!/usr/bin/env python3
import argparse
import json
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
QUEUED_DIR = REPO_ROOT / "state" / "queue" / "queued"
RUNNING_DIR = REPO_ROOT / "state" / "queue" / "running"
RUNS_DIR = REPO_ROOT / "state" / "runs"


def load(path: Path) -> dict:
    with path.open("r", encoding="utf-8") as handle:
        return json.load(handle)


def main() -> int:
    parser = argparse.ArgumentParser(description="Show Rack AI queue and run status")
    parser.add_argument("--emit-json", action="store_true")
    args = parser.parse_args()

    queued = sorted(p.name for p in QUEUED_DIR.glob("*.json")) if QUEUED_DIR.exists() else []
    running = sorted(p.name for p in RUNNING_DIR.glob("*.json")) if RUNNING_DIR.exists() else []
    runs = []
    if RUNS_DIR.exists():
        for path in sorted(RUNS_DIR.glob("*.json")):
            payload = load(path)
            runs.append(
                {
                    "task_id": payload.get("task_id"),
                    "status": payload.get("status"),
                    "attempt": payload.get("attempt"),
                    "max_attempts": payload.get("max_attempts"),
                    "last_error": payload.get("last_error"),
                }
            )

    summary = {"queued": queued, "running": running, "runs": runs}
    if args.emit_json:
        print(json.dumps(summary, indent=2))
        return 0

    print(f"Queued: {len(queued)}")
    for item in queued:
        print(f"  - {item}")
    print(f"Running: {len(running)}")
    for item in running:
        print(f"  - {item}")
    print(f"Runs: {len(runs)}")
    for item in runs:
        print(f"  - {item['task_id']}: {item['status']} (attempt {item['attempt']}/{item['max_attempts']})")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
